# Skill data format
# Optional: Curve: standard | invention
# Optional: Locked: true | false (default true)
# Method block:
# Method: <name>
# Type: <any tab name> (optional, default Default)
# Level: <required-level> (optional, default 1)
# XP: <value>
#
# Boost block:
# Boost: <name>
# Type: <any group name> (optional, default General)
# XP-Percent: <percent> (optional, at least one XP field required)
# XP-Multiplier: <multiplier> (optional, at least one XP field required)
# XP-Flat: <flat-xp> (optional, at least one XP field required)
# Slots: <slot, slot, ...> (optional)
# Set-Name: <name> (optional)
# Set-Pieces: <slot, slot, ...> (optional)
# Set-Bonus: true | false (optional)
# Disables: <boost-name or type|boost-name, ...> (optional)

Curve: standard

Locked: true

